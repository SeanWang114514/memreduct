	LTEXT			"", IDC_LANGUAGE_HINT, 8, 104, 112, 12, SS_CENTERIMAGE
	COMBOBOX		IDC_LANGUAGE, 128, 104, 124, 30, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
}

